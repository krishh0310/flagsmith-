{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "types": ["node"]
  },
  "include": ["examples/**/*.ts", "scripts/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "vite.config.ts", "playwright.config.ts", "rehearsal.config.ts"]
}
