# Compose credentials. Use generated hex strings for both values.
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=

# Local dashboard account used by the provisioning script.
FLAGSMITH_ADMIN_EMAIL=admin@example.com
FLAGSMITH_ADMIN_PASSWORD=

# Local Flagsmith port. Keep the API URL on the same port if you change it.
FLAGSMITH_PORT=8000

# Demo app SDK settings. npm run setup:flagsmith fills in the two keys.
FLAGSMITH_API_URL=http://localhost:8000/api/v1/
FLAGSMITH_CURRENT_ENVIRONMENT_KEY=
FLAGSMITH_PROPOSED_ENVIRONMENT_KEY=
